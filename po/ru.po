#: update_station/dialog.py:54
msgid "Update Failed"
msgstr "Ошибка обновления"

#: update_station/dialog.py:59
msgid ""
"Press \"Detail\" to get information about the failure.\n"
"        Get help at https://forums.ghostbsd.org or ."
msgstr ""
"Нажмите \"Подробности\" для получения информации об этой ошибке.\n"
"        Получите помощь на https://forums.ghostbsd.org."

